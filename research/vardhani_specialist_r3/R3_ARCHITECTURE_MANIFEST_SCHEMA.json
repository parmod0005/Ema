{
  "format": "VARDHANI_SPECIALIST_R3_ARCHITECTURE_MANIFEST_SCHEMA_V1",
  "status": "SCHEMA_ONLY_NO_ARCHITECTURE_IDENTITY_ASSIGNED",
  "purpose": "Define the immutable fields that the recovered V0.2 high-specialist architecture must declare before teacher optimization is allowed.",
  "required_manifest_format": "VARDHANI_SPECIALIST_R3_ARCHITECTURE_MANIFEST_V1",
  "required_status": "SEALED_IMPLEMENTATION_READY_FOR_GATED_TRAINING",
  "required_fields": {
    "identity": [
      "teacher_name",
      "architecture_version",
      "exact_parameter_count",
      "source_bundle_sha256",
      "source_files"
    ],
    "source_files_each": ["path", "bytes", "sha256"],
    "input_contract": [
      "full_market_feature_schema_sha256",
      "option_feature_schema_sha256",
      "modality_mask_schema_sha256",
      "state_cache_contract",
      "15m_policy"
    ],
    "model_contract": [
      "temporal_encoder",
      "multi_timeframe_fusion",
      "specialist_experts",
      "meta_judgement",
      "uncertainty_head",
      "episodic_embedding_head",
      "output_heads"
    ],
    "training_contract": [
      "loss_heads",
      "loss_weights",
      "optimizer",
      "scheduler",
      "deterministic_seeds",
      "precision_policy",
      "gradient_clipping",
      "checkpoint_selection_metric"
    ],
    "safety_contract": [
      "frozen_r2_untouched",
      "validation_gradients_forbidden",
      "sealed_2026",
      "historical_d30_forbidden",
      "fabricated_modalities_forbidden",
      "real_orders_disabled"
    ]
  },
  "semantic_requirements": {
    "15m_policy": "CONTEXT_NON_VETO",
    "frozen_r2_untouched": true,
    "validation_gradients_forbidden": true,
    "sealed_2026": true,
    "historical_d30_forbidden": true,
    "fabricated_modalities_forbidden": true,
    "real_orders_disabled": true,
    "loss_weights_must_be_explicit": true,
    "optimizer_must_be_explicit": true,
    "deterministic_seeds_must_be_nonempty": true,
    "checkpoint_selection_metric_must_be_predeclared": true
  },
  "rule": "This schema intentionally does not provide an architecture SHA, exact parameter count, loss weights or optimizer values. Those values must be recovered from or generated by the actual V0.2 implementation and sealed before training; they may not be guessed to make the pipeline run."
}
